# Motif UI — environment template. Copy to .env for local development.
# The MVP demo runs fully on mock data (src/lib/data.ts) — no database required.

# --- Database (production / when wiring Prisma) ---
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/motifui?schema=public"

# --- Auth (Auth.js) ---
# AUTH_SECRET="generate-with: npx auth secret"
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# --- Stripe (commerce, launch phase) ---
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- AI prompt testing gateway (ai-sdk style provider keys) ---
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# ZHIPU_API_KEY=""

# --- Misc ---
# NEXT_PUBLIC_SITE_URL="https://motifui.dev"
